#!/bin/bash
set -euo pipefail
umask 077
app=${1:?application required}
name=${2:?secret name required}
source=${3:?absolute protected source file required}
[[ "$app" =~ ^[a-z][a-z0-9-]{0,31}$ && "$name" =~ ^[a-z][a-z0-9-]{0,63}$ ]]
test "$(id -u)" = 0
test "$(getenforce)" = Enforcing
test -f "/etc/minimal-host/apps/$app.json"
[[ "$source" = /* && ! -L "$source" ]]
test "$(stat -c '%u:%a' "$source")" = 0:600
parent=${source%/*}
while :; do
  test -n "$parent" || parent=/
  test ! -L "$parent"
  test "$(stat -c %u "$parent")" = 0
  mode=$(stat -c %a "$parent")
  (( (8#$mode & 0022) == 0 ))
  [[ "$parent" != / ]] || break
  parent=${parent%/*}
done
directory="/etc/minimal-host/app-secrets/$app"
test -d "$directory"
stage=$(mktemp "$directory/.new.XXXXXX")
trap 'rm -f -- "$stage"' EXIT
install -m 0440 -o root -g "app-$app" -- "$source" "$stage"
chcon -t container_file_t "$stage"
mv -f -- "$stage" "$directory/$name"
printf 'Installed secret file for %s; restart its accepted release to consume rotation.\n' "$app"
